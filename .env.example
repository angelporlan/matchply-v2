# Copia este archivo a .env y ajusta los valores.
# Nunca subas .env a git.

NODE_ENV=development
NEXT_PUBLIC_APP_NAME=Matchply

# URI de Postgres (Supabase → Connect → Shared Pooler).
# Lleva la contraseña: nunca la prefijes con NEXT_PUBLIC_.
DATABASE_URL=postgresql://postgres.xxxx:[PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres

# Gemini. Solo servidor. https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# URL pública (Vercel). Para Stripe Checkout y redirects.
APP_URL=http://localhost:3000

# Stripe (test mode). El webhook es la fuente de verdad del plan pro.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
